include "test"
| include "pattern"
|

def _node(md): first(to_markdown(md));

def _doc():
  to_markdown("# Alpha\n\n[a](http://a.example)\n\n# Beta\n\nSee [docs](http://b.example) for more.\n\n## Gamma\n\n[g](https://g.example)\n\n# Delta\n\nJust text.\n");

# -- captures --

def test_captures_link():
  assert_eq(captures(_node("[docs](http://example.com/a)"), "[$text]($url)"), {"text": "docs", "url": "http://example.com/a"})
end

def test_captures_image():
  assert_eq(captures(_node("![alt](img.png)"), "![$alt]($src)"), {"alt": "alt", "src": "img.png"})
end

def test_captures_task_item():
  assert_eq(captures(first(to_markdown("- [ ] todo one\n- [x] done\n")), "- [ ] $item"), {"item": "todo one"})
end

def test_captures_heading():
  assert_eq(captures(_node("# Title"), "# $title"), {"title": "Title"})
end

def test_captures_heading_level_is_distinguished():
  assert_eq(captures(_node("## Gamma"), "# $head"), None)
end

def test_captures_no_match():
  assert_eq(captures(_node("[docs](http://x)"), "![$alt]($src)"), None)
end

def test_captures_escapes_regex_metacharacters():
  assert_eq(captures(_node("[a.b](http://x)"), "[a.b]($url)"), {"url": "http://x"})
end

# -- matches --

def test_matches_true():
  assert_true(matches(_node("[docs](http://x)"), "[$text](http://$rest)"))
end

def test_matches_false():
  assert_false(matches(_node("[docs](https://x)"), "[$text](http://$rest)"))
end

# -- replace --

def test_replace_rewrites_matching_node():
  let r = replace(_node("[docs](http://example.com)"), "[$text](http://$rest)", "[$text](https://$rest)")
  | assert_eq(to_string(r), "[docs](https://example.com)")
end

def test_replace_returns_non_matching_node_as_is():
  let n = _node("[docs](https://example.com)")
  | assert_eq(to_string(replace(n, "[$text](http://$rest)", "[$text](https://$rest)")), "[docs](https://example.com)")
end

def test_replace_task_item():
  let r = replace(first(to_markdown("- [ ] todo one\n")), "- [ ] $i", "- [x] $i")
  | assert_eq(to_string(r), "- [x] todo one")
end

# -- find_all --

def test_find_all_consecutive_blocks():
  let found = find_all(_doc(), "# $head\n\n[$text](http://$rest)")
  | assert_eq(len(found), 1)
  | assert_eq(first(found)["captures"], {"head": "Alpha", "text": "a", "rest": "a.example"})
  | assert_eq([first(found)["start"], first(found)["end"]], [0, 2])
end

def test_find_all_gap_skips_nodes_in_same_section():
  let found = find_all(_doc(), "# $head\n\n$$$\n\n[$text](http://$rest)")
  | assert_eq(map(found, fn(m): m["captures"]["head"];), ["Alpha", "Beta"])
end

def test_find_all_level_is_distinguished():
  let found = find_all(_doc(), "## $head\n\n[$text](https://$rest)")
  | assert_eq(map(found, fn(m): m["captures"]["head"];), ["Gamma"])
end

def test_find_all_no_match():
  assert_eq(find_all(_doc(), "# $head\n\n![$a]($b)"), [])
end

def test_find_all_gap_does_not_cross_heading():
  assert_eq(find_all(_doc(), "# Alpha\n\n$$$\n\n[$text](https://$rest)"), [])
end

# -- replace_all --

def test_replace_all_rewrites_matched_range_only():
  let out = replace_all(_doc(), "# $head\n\n[$text](http://$rest)", "# $head\n\n[$text](https://$rest)")
  | assert_eq(len(out), len(_doc()))
  | assert_eq(to_string(out[1]), "[a](https://a.example)")
  | assert_eq(to_string(out[3]), "See ")
end

def test_replace_all_without_match_returns_nodes_unchanged():
  assert_eq(map(replace_all(_doc(), "# $head\n\n![$a]($b)", "x"), to_string), map(_doc(), to_string))
end

# -- nested nodes --

def _nested():
  "## Head [h](http://h)\n\n- item [m](http://v)\n\n> quote [l](http://u)\n\n> - li [e](http://e)\n\n**x [s](http://s)** end\n\n[top](http://t)\n";

def _urls_of(src, pat): map(find_all(to_markdown(src), pat), fn(m): m["captures"]["u"];);

def test_find_all_descends_into_heading_list_and_blockquote():
  assert_eq(_urls_of(_nested(), "[$t](http://$u)"), ["h", "v", "u", "e", "s", "t"])
end

def test_find_all_marks_nested_matches():
  let found = find_all(to_markdown("[a](http://a)\n\n- [b](http://b)\n"), "[$t](http://$u)")
  | assert_eq(map(found, fn(m): m["nested"];), [false, true])
  | assert_eq(map(found, fn(m): m["top"];), [0, 1])
end

def test_find_all_does_not_search_inside_a_match():
  let found = find_all(to_markdown("- [a](http://a) and [b](http://b)\n"), "- $x")
  | assert_eq(len(found), 1)
end

def test_find_all_link_pattern_does_not_swallow_following_text():
  let found = find_all(to_markdown("- [a](http://x) and [c](http://y)\n"), "[$t](http://$u)")
  | assert_eq(map(found, fn(m): m["captures"]["u"];), ["x", "y"])
end

def test_find_all_list_item_inside_blockquote():
  let found = find_all(to_markdown("> - [ ] a\n> - [x] b\n"), "- [ ] $i")
  | assert_eq(map(found, fn(m): m["captures"]["i"];), ["a"])
end

def test_rule_inside_heading_applies_to_nested_matches():
  let ns = to_markdown("# Guide\n\n## Install\n\n- see [a](http://a)\n\n## Usage\n\n- see [b](http://b)\n")
  | assert_eq(_urls(find_rule(ns, {"pattern": "[$t](http://$u)", "inside": "## Install"})), ["a"])
  | assert_eq(_urls(find_rule(ns, {"pattern": "[$t](http://$u)", "not_inside": "## Install"})), ["b"])
end

def test_replace_all_leaves_nested_matches_alone():
  let ns = to_markdown("[a](http://a)\n\n- [b](http://b)\n")
  | assert_eq(map(replace_all(ns, "[$t](http://$u)", "[$t](https://$u)"), to_string), ["[a](https://a)", "- [b](http://b)"])
end

def test_rewrite_source_nested_matches():
  let src = "## Head [h](http://h)\n\n- item [m](http://v)\n\n> quote [l](http://u)\n"
  | let ms = find_all(to_markdown(src), "[$t](http://$u)")
  | assert_eq(rewrite_source(src, ms, "[$t](https://$u)"), "## Head [h](https://h)\n\n- item [m](https://v)\n\n> quote [l](https://u)\n")
end

def test_rewrite_source_table_cell_keeps_pipes():
  let src = "| a | b |\n|---|---|\n| [c](http://c) | d |\n"
  | let ms = find_all(to_markdown(src), "[$t](http://$u)")
  | assert_eq(rewrite_source(src, ms, "[$t](https://$u)"), "| a | b |\n|---|---|\n| [c](https://c) | d |\n")
end

def test_report_table_cell_position_is_its_content():
  let ms = find_all(to_markdown("| a |\n|---|\n| [c](http://c) |\n"), "[$t]($u)")
  | assert_eq(report(first(ms)), "3:3  [c](http://c)\n       $t = c\n       $u = http://c")
end

# -- structural matching --

def _caps_of(src, pat): map(find_all(to_markdown(src), pat), fn(m): m["captures"];);

def test_link_pattern_in_item_does_not_swallow_following_text():
  assert_eq(_caps_of("- [a](http://x) and [c](http://y)\n", "- [$t]($u)"), [])
end

def test_strong_pattern_in_item_does_not_match_two_strongs():
  assert_eq(_caps_of("- **a** and **b**\n", "- **$x**"), [])
end

def test_strong_pattern_matches_whole_item():
  assert_eq(_caps_of("- **a b**\n", "- **$x**"), [{"x": "a b"}])
end

def test_link_capture_is_the_url_not_its_escaped_source():
  assert_eq(_caps_of("[a](http://e.org/a_(b))\n", "[$t]($u)"), [{"t": "a", "u": "http://e.org/a_(b)"}])
end

def test_link_text_with_markup_is_captured_as_source():
  assert_eq(_caps_of("[a *b*](http://x)\n", "[$t]($u)"), [{"t": "a *b*", "u": "http://x"}])
end

def test_pattern_nested_markup_is_matched_structurally():
  assert_eq(_caps_of("**[a](http://x)** and **plain**\n", "**[$t]($u)**"), [{"t": "a", "u": "http://x"}])
end

def test_task_item_pattern_does_not_match_plain_item():
  assert_eq(_caps_of("- a\n- [ ] b\n- [x] c\n", "- [ ] $i"), [{"i": "b"}])
end

def test_plain_item_pattern_does_not_match_task_item():
  assert_eq(_caps_of("- a\n- [ ] b\n", "- $i"), [{"i": "a"}])
end

def test_ordered_and_bullet_items_are_distinguished():
  assert_eq(_caps_of("1. one\n\n- two\n", "1. $i"), [{"i": "one"}])
end

def test_inline_code_pattern_does_not_match_code_block():
  assert_eq(_caps_of("```rust\nfn a() {}\n```\n", "`$c`"), [])
end

def test_code_block_pattern_may_contain_blank_line():
  assert_eq(_caps_of("```rust\nfn a() {}\n\nfn b() {}\n```\n", "```$l\n$c\n```"), [{"l": "rust", "c": "fn a() {}\n\nfn b() {}"}])
end

def test_pattern_with_dollar_amount_text_is_literal():
  assert_eq(_caps_of("costs 5 dollars\n", "costs $n dollars"), [{"n": "5"}])
end

def test_underscore_in_metavariable_name():
  assert_eq(_caps_of("[a](b)\n", "[$link_text]($link_url)"), [{"link_text": "a", "link_url": "b"}])
end

def test_pattern_inline_nodes_match_consecutive_siblings():
  assert_eq(_caps_of("See [a](http://x) now\n", "See [$t]($u)"), [{"t": "a", "u": "http://x"}])
end

def test_table_pattern_matches_cells_in_order():
  assert_eq(_caps_of("| a | b |\n|---|---|\n| 1 | 2 |\n", "| $h1 | $h2 |\n|---|---|\n| $c1 | $c2 |"), [{"h1": "a", "h2": "b", "c1": "1", "c2": "2"}])
end

def test_capture_order_follows_the_pattern():
  assert_eq(keys(first(_caps_of("[a](http://x \"T\")\n", "[$t]($u \"$title\")"))), ["t", "u", "title"])
end

def test_gap_name_with_underscore():
  let src = "# A\n\nfirst\n\nsecond\n"
  | let ms = find_all(to_markdown(src), "# A\n\n$$$the_body")
  | assert_eq(rewrite_source(src, ms, "# Z\n\n$$$the_body"), "# Z\n\nfirst\n\nsecond\n")
end

def test_metavariable_twice_across_nodes_must_agree():
  assert_eq(_caps_of("[a](a)\n\n[a](b)\n", "[$t]($t)"), [{"t": "a"}])
end

# -- repeated metavariables --

def test_captures_same_variable_must_match_same_text():
  assert_eq(captures(_node("[same](same)"), "[$t]($t)"), {"t": "same"})
end

def test_captures_same_variable_with_different_text_does_not_match():
  assert_eq(captures(_node("[a](b)"), "[$t]($t)"), None)
end

def test_find_all_same_variable_across_blocks():
  let ns = to_markdown("# Intro\n\n[Intro](#intro)\n\n# Other\n\n[x](#y)\n")
  | assert_eq(len(find_all(ns, "# $h\n\n[$h](#$a)")), 1)
end

# -- links and titles --

def test_captures_titled_link_without_title_in_pattern():
  assert_eq(captures(_node("[home](https://x.org \"Home page\")"), "[$text]($url)"), {"text": "home", "url": "https://x.org"})
end

def test_captures_title():
  assert_eq(captures(_node("[home](https://x.org \"Home page\")"), "[$text]($url \"$title\")"), {"text": "home", "url": "https://x.org", "title": "Home page"})
end

def test_captures_title_pattern_does_not_match_untitled_link():
  assert_eq(captures(_node("[home](https://x.org)"), "[$text]($url \"$title\")"), None)
end

def test_captures_image_is_not_a_link():
  assert_eq(captures(_node("![alt](img.png)"), "[$text]($url)"), None)
end

def test_replace_keeps_link_title():
  let r = replace(_node("[home](http://x.org \"Home page\")"), "[$t](http://$r)", "[$t](https://$r)")
  | assert_eq(to_string(r), "[home](https://x.org \"Home page\")")
end

def test_replace_drops_title_when_pattern_mentions_it():
  let r = replace(_node("[home](http://x.org \"Home page\")"), "[$t](http://$r \"$title\")", "[$t](https://$r)")
  | assert_eq(to_string(r), "[home](https://x.org)")
end

# -- template filters --

# @parametrize([["upcase", "HELLO WORLD"], ["downcase", "hello world"], ["capitalize", "Hello World"], ["slug", "hello-world"]])
def test_template_filter(f, expected):
  let r = replace(_node("# Hello World"), "# $t", "# ${t|" + f + "}")
  | assert_eq(to_string(r), "# " + expected)
end

def test_template_filters_chain():
  let r = replace(_node("# Hello World"), "# $t", "[${t|slug|upcase}](#x)")
  | assert_eq(to_string(r), "[HELLO-WORLD](#x)")
end

def test_template_unknown_variable_is_kept():
  let ms = find_all(to_markdown("# Title\n"), "# $t")
  | assert_eq(rewrite_source("# Title\n", ms, "# $t $other"), "# Title $other\n")
end

# -- named gaps --

def test_find_all_named_gap_captures_skipped_nodes():
  let found = find_all(_doc(), "# $head\n\n$$$body\n\n[$text](http://$rest)")
  | assert_eq(len(found), 2)
  | assert_eq(len(first(found)["captures"]["body"]), 0)
  | assert_eq(join_nodes(found[1]["captures"]["body"]), "See ")
end

def test_find_all_trailing_gap_takes_rest_of_section():
  let found = find_all(_doc(), "# $head\n\n$$$")
  | assert_eq(map(found, fn(m): m["end"] - m["start"];), [2, 4, 2])
end

def test_find_all_gap_name_can_be_reused_in_replacement():
  let src = "# A\n\nfirst\n\nsecond\n\n# B\n"
  | let ns = to_markdown(src)
  | let ms = find_all(ns, "# A\n\n$$$body")
  | assert_eq(rewrite_source(src, ms, "# Z\n\n$$$body"), "# Z\n\nfirst\n\nsecond\n\n# B\n")
end

# -- joining nodes --

# @parametrize([["a [b](c) d", "a [b](c) d"], ["# T\n\ntext\n\ntext2", "# T\n\ntext\n\ntext2"], ["- x\n- y", "- x\n- y"]])
def test_join_nodes_restores_source(src, expected):
  assert_eq(join_nodes(to_markdown(src)), expected)
end

# -- rules --

def _rich_src():
  "# Guide\n\n## Install\n\nGet [home](https://x.org) or [mirror](http://m.org).\n\n```rust\nfn main() {}\n```\n\n```sh\ncargo install foo\n```\n\n## Usage\n\n[a](http://a.example) and [b](https://b.example).\n\n### Details\n\nSee [deep](http://deep.example).\n";

def _rich(): to_markdown(_rich_src());

def _urls(ms): map(ms, fn(m): m["captures"]["u"];);

def test_rule_kind():
  assert_eq(len(find_rule(_rich(), {"pattern": "```$l\n$c\n```", "kind": "code"})), 2)
end

def test_rule_lang():
  let found = find_rule(_rich(), {"pattern": "```$l\n$c\n```", "lang": "rust"})
  | assert_eq(map(found, fn(m): m["captures"]["c"];), ["fn main() {}"])
end

def test_rule_inside_heading():
  assert_eq(_urls(find_rule(_rich(), {"pattern": "[$t]($u)", "inside": "## Install"})), ["https://x.org", "http://m.org"])
end

def test_rule_inside_includes_nested_headings():
  assert_eq(_urls(find_rule(_rich(), {"pattern": "[$t]($u)", "inside": "## Usage"})), ["http://a.example", "https://b.example", "http://deep.example"])
end

def test_rule_inside_adds_heading_captures():
  let found = find_rule(_rich(), {"pattern": "[$t](http://$u)", "inside": "## $section"})
  | assert_eq(map(found, fn(m): m["captures"]["section"];), ["Install", "Usage", "Usage"])
end

def test_rule_not_inside():
  assert_eq(_urls(find_rule(_rich(), {"pattern": "[$t](http://$u)", "not_inside": "## Install"})), ["a.example", "deep.example"])
end

def test_rule_constraints():
  assert_eq(_urls(find_rule(_rich(), {"pattern": "[$t]($u)", "constraints": {"u": "^https"}})), ["https://x.org", "https://b.example"])
end

def test_rule_not_constraints():
  assert_eq(_urls(find_rule(_rich(), {"pattern": "[$t]($u)", "not_constraints": {"u": "^https"}})), ["http://m.org", "http://a.example", "http://deep.example"])
end

def test_replace_rule_only_changes_matches_in_rule():
  let out = replace_rule(_rich(), {"pattern": "[$t](http://$u)", "inside": "## Install"}, "[$t](https://$u)")
  | assert_eq(len(out), len(_rich()))
  | assert_eq(len(filter(map(out, to_string), fn(s): s == "[mirror](https://m.org)";)), 1)
  | assert_eq(len(filter(map(out, to_string), fn(s): s == "[a](http://a.example)";)), 1)
end

# -- rewriting source --

def test_rewrite_source_changes_only_matches():
  let src = "# Guide\n\nGet [home](http://x.org \"Home\") now.\n\n    code   kept\n"
  | let ms = find_all(to_markdown(src), "[$t](http://$r)")
  | assert_eq(rewrite_source(src, ms, "[$t](https://$r)"), "# Guide\n\nGet [home](https://x.org \"Home\") now.\n\n    code   kept\n")
end

def test_rewrite_source_with_multibyte_text():
  let src = "日本語 [リンク](http://u) 終わり\n"
  | let ms = find_all(to_markdown(src), "[$t](http://$r)")
  | assert_eq(rewrite_source(src, ms, "[$t](https://$r)"), "日本語 [リンク](https://u) 終わり\n")
end

def test_rewrite_source_list_item_keeps_indent_and_other_items():
  let src = "  - [ ] 項目\n- [x] done\n- [ ] more\n"
  | let ms = find_all(to_markdown(src), "- [ ] $i")
  | assert_eq(rewrite_source(src, ms, "- [x] $i"), "  - [x] 項目\n- [x] done\n- [x] more\n")
end

def test_rewrite_source_multi_node_range():
  let src = "# Alpha\n\n[a](http://a.example)\n\n# Beta\n"
  | let ms = find_all(to_markdown(src), "# $h\n\n[$t](http://$r)")
  | assert_eq(rewrite_source(src, ms, "# $h\n\n[$t](https://$r)"), "# Alpha\n\n[a](https://a.example)\n\n# Beta\n")
end

def test_rewrite_source_without_matches_returns_source():
  assert_eq(rewrite_source("# A\n", [], "x"), "# A\n")
end

# -- reporting --

def test_report_shows_position_source_and_captures():
  let ns = to_markdown("# A\n\n[x](http://y)\n")
  | let ms = find_all(ns, "[$t](http://$r)")
  | assert_eq(report(first(ms)), "3:1  [x](http://y)\n       $t = x\n       $r = y")
end

def test_report_aligns_the_lines_of_a_multi_line_match():
  let ms = find_all(to_markdown("```sh\nls\n```\n"), "```$l\n$c\n```")
  | assert_eq(report(first(ms)), "1:1  ```sh\n     ls\n     ```\n       $l = sh\n       $c = ls")
end

def test_group_names_the_file_once_and_separates_matches_with_a_blank_line():
  assert_eq(group("a.md", ["1:1  x", "2:1  y"]), ["a.md\n1:1  x\n\n2:1  y"])
  | assert_eq(group("a.md", []), [])
end

def test_preview_shows_old_and_new_text():
  let ms = find_all(to_markdown("[x](http://y)\n"), "[$t](http://$r)")
  | assert_eq(preview(first(ms), "[x](https://y)"), "1:1  - [x](http://y)\n     + [x](https://y)")
end

def test_describe_has_location_and_captures():
  let ms = find_all(to_markdown("# A\n\n[x](http://y)\n"), "[$t](http://$r)")
  | let d = describe(first(ms), None)
  | assert_eq([d["file"], d["start_line"], d["start_column"], d["end_line"], d["end_column"]], ["<stdin>", 3, 1, 3, 14])
  | assert_eq(d["captures"], {"t": "x", "r": "y"})
end

# -- command line --

def test_unescape_turns_backslash_n_into_line_break():
  assert_eq(unescape("# $h\\n\\n[$t]($u)"), "# $h\n\n[$t]($u)")
end

# Documents the `run` tests below read by name. Files are written to the test's own file
# system before `run`, because `doc` and `write` read them back.
def _fixture(name):
  if (name == "tiny"):
    "[x](http://y)\n"
  elif (name == "rich"):
    _rich_src()
  elif (name == "sample"):
    "# Guide\n\n## Install\n\nGet it from [home](https://x.org \"Home page\") or [mirror](http://m.org).\n\n```rust\nfn main() {}\n```\n\n```sh\ncargo install foo\n```\n\n## Usage\n\n[same](same) and [a](b).\n\n- [ ] todo one\n- [x] done\n\n### Details\n\nNotes: [deep](http://deep.example).\n"
  elif (name == "tree"):
    "# Guide\n\n## Install\n\n- see [home](http://a.example)\n\n> note [mirror](http://b.example)\n\n## Usage\n\n| name | link |\n|---|---|\n| docs | [d](http://c.example) |\n"
  else:
    "日本語 [リンク](http://u) 終わり\n\n  - [ ] 項目\n- [x] done\n";

def _run_on(name, args):
  let src = _fixture(name)
  | let file = name + ".md"
  | write_file(file, src)
  | run(to_markdown(src), args, file);

def _swap(s, from, to): regex_replace(s, from, fn(m): to;);

def _without_final_break(s): regex_replace(s, "\n$", fn(m): "";);

# @parametrize([["tiny", {"pattern": "[$t](http://$r)"}, ["tiny.md\n1:1  [x](http://y)\n       $t = x\n       $r = y"]], ["sample", {"pattern": "[$t]($t)"}, ["sample.md\n17:1  [same](same)\n        $t = same"]], ["sample", {"pattern": "[$t]($u \"$title\")"}, ["sample.md\n5:13  [home](https://x.org \"Home page\")\n        $t = home\n        $u = https://x.org\n        $title = Home page"]], ["sample", {"pattern": "[$t]($u)", "inside": "## Install", "constraints": {"u": "^http:"}}, ["sample.md\n5:50  [mirror](http://m.org)\n        $t = mirror\n        $u = http://m.org"]], ["tree", {"pattern": "[$t]($u)", "inside": "## Install"}, ["tree.md\n5:7  [home](http://a.example)\n       $t = home\n       $u = http://a.example\n\n7:8  [mirror](http://b.example)\n       $t = mirror\n       $u = http://b.example"]]])
def test_run_report(name, args, expected):
  assert_eq(_run_on(name, args), expected)
end

# @parametrize([["rich", {"pattern": "[$t]($u)", "output": "count"}, ["rich.md: 5"]], ["rich", {"rule": {"pattern": "[$t]($u)", "kind": "image"}, "kind": "link", "output": "count"}, ["rich.md: 5"]], ["sample", {"pattern": "[$t]($u)", "output": "count"}, ["sample.md: 5"]], ["sample", {"pattern": "```$l\\n$c\\n```", "kind": "code", "lang": "rust", "output": "count"}, ["sample.md: 1"]], ["tree", {"pattern": "[$t](http://$r)", "output": "count"}, ["tree.md: 3"]]])
def test_run_count(name, args, expected):
  assert_eq(_run_on(name, args), expected)
end

# @parametrize([["tiny", {"pattern": "[$t](http://$r)", "rewrite": "[$t](https://$r)"}, ["tiny.md\n1:1  - [x](http://y)\n     + [x](https://y)"]], ["sample", {"pattern": "[$t](http://$r)", "rewrite": "[$t](https://$r)"}, ["sample.md\n5:50  - [mirror](http://m.org)\n      + [mirror](https://m.org)\n\n24:8  - [deep](http://deep.example)\n      + [deep](https://deep.example)"]]])
def test_run_preview(name, args, expected):
  assert_eq(_run_on(name, args), expected)
end

# `doc` prints the whole document, so a rewrite of `http://` links must equal the same
# textual replacement over the source: nothing but the matches changes.
# @parametrize([["sample", "http://", "https://"], ["tree", "http://", "https://"]])
def test_run_doc_changes_only_matches(name, from, to):
  let args = {"pattern": "[$t](http://$r)", "rewrite": "[$t](https://$r)", "output": "doc"}
  | assert_eq(_run_on(name, args), [_without_final_break(_swap(_fixture(name), from, to))])
end

def test_run_write_updates_the_file_and_keeps_multibyte_text():
  let args = {"pattern": " - [ ] $i", "rewrite": " - [x] $i", "write": true}
  | assert_eq(_run_on("ja", args), ["ja.md: 1 replaced"])
  | assert_eq(read_file("ja.md"), "日本語 [リンク](http://u) 終わり\n\n  - [x] 項目\n- [x] done\n")
end
